# Copy to .env.local (gitignored) and fill in real values. .env.local is
# loaded by server.mjs on boot; real process.env always wins over this file.

# Required for real token minting. Server-side only — NEVER sent to the
# glasses device or logged.
OPENAI_API_KEY=your-openai-api-key

# Required. Shared secret the glasses client presents via the
# X-Lumella-Local-Token header. Pair this with glasses/local.properties'
# lumella.localToken (also gitignored). Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
LUMELLA_LOCAL_TOKEN=devtest-change-me

# Optional. Defaults shown.
PORT=8788
BIND=127.0.0.1
OPENAI_REALTIME_MODEL=gpt-realtime
